<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/8"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.UserProfileController"
           style="-fx-background-color: linear-gradient(to bottom right, #e0f7fa, #ffffff);">

    <!-- Centered card -->
    <VBox alignment="CENTER"
          spacing="20"
          maxWidth="500"
          style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.3, 0, 4);">

        <!-- Title -->
        <Label text="My Profile"
               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <!-- Grid for profile info -->
        <GridPane hgap="15" vgap="15">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="100"/>
                <ColumnConstraints halignment="LEFT" minWidth="200"/>
            </columnConstraints>

            <Label text="First Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="firstNameLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Last Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="lastNameLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Username:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="usernameLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Email:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label fx:id="emailLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Phone:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Label fx:id="phoneLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Role:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <Label fx:id="roleLabel" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <Label text="Created At:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <Label fx:id="createdAtLabel" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        </GridPane>

        <!-- Action buttons -->
        <HBox spacing="15" alignment="CENTER">
            <Button text="Modify Profile"
                    onAction="#handleModify"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 8;"/>

            <Button text="Back"
                    onAction="#handleBack"
                    style="-fx-background-color: #bdc3c7; -fx-text-fill: white; -fx-background-radius: 8;"/>

            <Button text="Delete Account"
                    onAction="#handleDeleteAccount"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 8;"/>
        </HBox>
    </VBox>
</StackPane>
