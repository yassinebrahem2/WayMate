<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.UserEditController"
           style="-fx-background-color: linear-gradient(to bottom right, #e0f7fa, #ffffff);">

    <VBox alignment="CENTER"
          spacing="15"
          style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.3, 0, 4);"
          maxWidth="400">

        <Label text="Edit Profile"
               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <TextField fx:id="firstNameField" promptText="First Name"/>
        <TextField fx:id="lastNameField" promptText="Last Name"/>
        <TextField fx:id="usernameField" promptText="Username"/>
        <TextField fx:id="emailField" promptText="Email"/>
        <TextField fx:id="phoneField" promptText="Phone Number"/>
        <PasswordField fx:id="passwordField" promptText="New Password (optional)"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Confirm New Password"/>

        <HBox spacing="10" alignment="CENTER">
            <Button text="Save Changes"
                    onAction="#handleSave"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 8;"/>
            <Button text="Cancel"
                    onAction="#handleCancel"
                    style="-fx-background-color: #bdc3c7; -fx-text-fill: white; -fx-background-radius: 8;"/>
        </HBox>

        <Label fx:id="messageLabel" textFill="red" wrapText="true" style="-fx-padding: 10 0 0 0;"/>

    </VBox>
</StackPane>
