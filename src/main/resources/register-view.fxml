<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.RegisterController" stylesheets="@loginstyle.css">

    <!-- Main container with shadow effect -->
    <HBox fx:id="registerContainer" maxHeight="-Infinity" maxWidth="-Infinity"
          minHeight="500.0" minWidth="800.0" prefHeight="500.0" prefWidth="800.0"
          styleClass="main-container">
        <children>
            <!-- Left panel with circles and logo (same as login) -->
            <StackPane prefHeight="500.0" prefWidth="350.0" styleClass="left-panel">
                <children>
                    <Circle fx:id="bigCircle1" radius="100.0" styleClass="big-circle" StackPane.alignment="BOTTOM_LEFT">
                        <StackPane.margin>
                            <Insets bottom="-50.0" left="-50.0" />
                        </StackPane.margin>
                    </Circle>
                    <Circle fx:id="bigCircle2" radius="80.0" styleClass="big-circle" StackPane.alignment="CENTER_RIGHT">
                        <StackPane.margin>
                            <Insets right="-40.0" />
                        </StackPane.margin>
                    </Circle>

                    <VBox alignment="CENTER_LEFT" maxWidth="280.0" StackPane.alignment="CENTER">
                        <StackPane.margin>
                            <Insets left="30.0" />
                        </StackPane.margin>
                        <children>
                            <ImageView fitHeight="280.0" fitWidth="271.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@image/WayMate-white-logo.png" />
                                </image>
                            </ImageView>
                        </children>
                    </VBox>
                </children>
            </StackPane>

            <!-- Right panel with registration form -->
            <StackPane prefHeight="500.0" prefWidth="450.0" styleClass="right-panel">
                <children>
                    <VBox alignment="CENTER" maxWidth="350.0" spacing="15.0">
                        <children>
                            <!-- Title -->
                            <Label styleClass="signin-title" text="Create Account">
                                <font>
                                    <Font name="System Bold" size="24.0" />
                                </font>
                            </Label>
                            <Label styleClass="info-text" text="Fill in your details to get started">
                                <VBox.margin>
                                    <Insets bottom="10.0" top="-15.0" />
                                </VBox.margin>
                            </Label>

                            <!-- Registration form fields -->
                            <VBox spacing="10.0">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <!-- First Name -->
                                    <HBox alignment="CENTER_LEFT" styleClass="input-container" HBox.hgrow="ALWAYS">
                                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@image/user-icon.png" />
                                            </image>
                                            <HBox.margin>
                                                <Insets left="10.0" />
                                            </HBox.margin>
                                        </ImageView>
                                        <TextField fx:id="firstNameField" promptText="First Name" styleClass="modern-field">
                                            <HBox.margin>
                                                <Insets left="10.0" />
                                            </HBox.margin>
                                        </TextField>
                                    </HBox>

                                    <!-- Last Name -->
                                    <HBox alignment="CENTER_LEFT" styleClass="input-container" HBox.hgrow="ALWAYS">
                                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@image/user-icon.png" />
                                            </image>
                                            <HBox.margin>
                                                <Insets left="10.0" />
                                            </HBox.margin>
                                        </ImageView>
                                        <TextField fx:id="lastNameField" promptText="Last Name" styleClass="modern-field">
                                            <HBox.margin>
                                                <Insets left="10.0" />
                                            </HBox.margin>
                                        </TextField>
                                    </HBox>
                                </HBox>

                                <!-- Username -->
                                <HBox alignment="CENTER_LEFT" styleClass="input-container">
                                    <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                        <image>
                                            <Image url="@image/user-icon.png" />
                                        </image>
                                        <HBox.margin>
                                            <Insets left="10.0" />
                                        </HBox.margin>
                                    </ImageView>
                                    <TextField fx:id="usernameField" promptText="Username" styleClass="modern-field">
                                        <HBox.margin>
                                            <Insets left="10.0" />
                                        </HBox.margin>
                                    </TextField>
                                </HBox>

                                <!-- Email -->
                                <HBox alignment="CENTER_LEFT" styleClass="input-container">
                                    <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                        <image>
                                            <Image url="@image/email-icon.png" />
                                        </image>
                                        <HBox.margin>
                                            <Insets left="10.0" />
                                        </HBox.margin>
                                    </ImageView>
                                    <TextField fx:id="emailField" promptText="Email" styleClass="modern-field">
                                        <HBox.margin>
                                            <Insets left="10.0" />
                                        </HBox.margin>
                                    </TextField>
                                </HBox>

                                <!-- Phone -->
                                <HBox alignment="CENTER_LEFT" styleClass="input-container">
                                    <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                        <image>
                                            <Image url="@image/phone-icon.png" />
                                        </image>
                                        <HBox.margin>
                                            <Insets left="10.0" />
                                        </HBox.margin>
                                    </ImageView>
                                    <TextField fx:id="phoneField" promptText="Phone Number" styleClass="modern-field">
                                        <HBox.margin>
                                            <Insets left="10.0" />
                                        </HBox.margin>
                                    </TextField>
                                </HBox>

                                <!-- Password -->
                                <HBox alignment="CENTER_LEFT" styleClass="input-container">
                                    <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                        <image>
                                            <Image url="@image/lock-icon.png" />
                                        </image>
                                        <HBox.margin>
                                            <Insets left="10.0" />
                                        </HBox.margin>
                                    </ImageView>
                                    <PasswordField fx:id="passwordField" promptText="Password" styleClass="modern-field">
                                        <HBox.margin>
                                            <Insets left="10.0" />
                                        </HBox.margin>
                                    </PasswordField>
                                </HBox>

                                <!-- Confirm Password -->
                                <HBox alignment="CENTER_LEFT" styleClass="input-container">
                                    <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                        <image>
                                            <Image url="@image/lock-icon.png" />
                                        </image>
                                        <HBox.margin>
                                            <Insets left="10.0" />
                                        </HBox.margin>
                                    </ImageView>
                                    <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" styleClass="modern-field">
                                        <HBox.margin>
                                            <Insets left="10.0" />
                                        </HBox.margin>
                                    </PasswordField>
                                </HBox>
                            </VBox>

                            <!-- Buttons -->
                            <HBox alignment="CENTER" spacing="10.0">
                                <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleReturnToLogin" styleClass="secondary-button" text="Back to Login" />
                                <Button fx:id="signUpButton" mnemonicParsing="false" onAction="#handleSignUp" styleClass="signin-button" text="Sign Up" />
                            </HBox>

                            <!-- Message label for errors/success -->
                            <Label fx:id="messageLabel" styleClass="error-message" text="" visible="false">
                                <VBox.margin>
                                    <Insets bottom="10.0" />
                                </VBox.margin>
                            </Label>
                        </children>
                    </VBox>
                </children>
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>
            </StackPane>
        </children>
    </HBox>
</StackPane>