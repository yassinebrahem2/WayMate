<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" styleClass="root-pane" stylesheets="@style.css" xmlns="http://javafx.com/javafx/22.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AdminHistoriqueBookingsController">
    <VBox prefHeight="600.0" prefWidth="800.0" spacing="15.0" AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0">
        <!-- Header with Title -->
        <Label text="Booking History" styleClass="header-label" alignment="CENTER" prefWidth="Infinity" />

        <!-- Search bar for vehicle license plate -->
        <HBox spacing="15.0" alignment="CENTER_LEFT" styleClass="control-section">
            <Label text="Search by Vehicle License Plate:" styleClass="input-label" />
            <TextField fx:id="vehicleSearchField" promptText="Enter vehicle license plate" onAction="#handleSearch" styleClass="styled-textfield" prefWidth="250.0" />
        </HBox>

        <!-- Checkboxes for filtering by status -->
        <HBox spacing="25.0" alignment="CENTER_LEFT" styleClass="control-section">
            <CheckBox fx:id="enCoursCheckBox" text="En Cours" onAction="#handleFilter" styleClass="styled-checkbox" />
            <CheckBox fx:id="termineeCheckBox" text="Terminée" onAction="#handleFilter" styleClass="styled-checkbox" />
            <CheckBox fx:id="annuleeCheckBox" text="Annulée" onAction="#handleFilter" styleClass="styled-checkbox" />
        </HBox>

        <!-- TableView for displaying filtered bookings -->
        <TableView fx:id="bookingTableHistorique" styleClass="styled-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="60.0" />
                <TableColumn fx:id="userIdColumn" text="User ID" prefWidth="80.0" />
                <TableColumn fx:id="vehicleColumn" text="Vehicle" prefWidth="100.0" />
                <TableColumn fx:id="startTimeColumn" text="Start Time" prefWidth="150.0" />
                <TableColumn fx:id="endTimeColumn" text="End Time" prefWidth="150.0" />
                <TableColumn fx:id="createdAtColumn" text="Created At" prefWidth="150.0" />
                <TableColumn fx:id="priceColumn" text="Price" prefWidth="80.0" />
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="100.0" />
                <TableColumn fx:id="actionColumn" text="Actions" prefWidth="120.0" />
            </columns>
        </TableView>
    </VBox>
</AnchorPane>