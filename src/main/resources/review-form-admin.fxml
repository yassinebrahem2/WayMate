<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.ReviewFormAdminController"
            prefWidth="800" prefHeight="500">
    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10"
              AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Liste des avis" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <TableView fx:id="reviewTable" prefHeight="400">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="userIdColumn" text="User ID" prefWidth="100"/>
                    <TableColumn fx:id="vehicleColumn" text="Vehicle Plate" prefWidth="100"/>
                    <TableColumn fx:id="ratingColumn" text="Rating" prefWidth="80"/>
                    <TableColumn fx:id="commentColumn" text="Comment" prefWidth="200"/>
                    <TableColumn fx:id="createdAtColumn" text="Created At" prefWidth="150"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Supprimer" onAction="#handleSupprimer"/>
            </HBox>

        </VBox>
    </children>
</AnchorPane>

