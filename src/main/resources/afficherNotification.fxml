<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom right, #f8fafc, #e2e8f0);" xmlns="http://javafx.com/javafx/22.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AdminNotificationController">

    <VBox alignment="CENTER" layoutX="50" layoutY="40" prefWidth="800" spacing="25">
        <!-- Titre avec emoji et ombre portée -->
        <Label style="-fx-font-size: 28px; -fx-text-fill: #2c3e50; -fx-font-weight: bold;" text="🔔 Liste des Notifications">
            <effect>
                <DropShadow color="rgba(0,0,0,0.1)" offsetX="1" offsetY="1" radius="3" />
            </effect>
        </Label>

        <!-- Carte du formulaire avec ombre et arrondis -->
        <StackPane style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);">
            <VBox prefWidth="750" spacing="20">
                <!-- Barre d'outils améliorée -->
                <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 0 0 15 0;">
                    <CheckBox fx:id="checkUnreadOnly" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;" text="Afficher seulement les non lues" />

                    <Button fx:id="btnRefresh" style="-fx-background-color: #e2e8f0; -fx-text-fill: #4a5568;                                    -fx-font-size: 14px; -fx-background-radius: 15;                                    -fx-padding: 7 15;" text="Actualiser">
                        <graphic>
                            <Label text="🔄" />
                        </graphic>
                    </Button>

                    <Button fx:id="btnAjouter" style="-fx-background-color: linear-gradient(to right, #3498db, #2ecc71);                                   -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;                                   -fx-background-radius: 15; -fx-padding: 7 20;" text="Ajouter">
                        <graphic>
                            <Label text="➕" />
                        </graphic>
                        <effect>
                            <DropShadow color="rgba(46,204,113,0.3)" offsetX="0" offsetY="2" radius="5" />
                        </effect>
                    </Button>

                    <Button fx:id="btnSendEmail" style="-fx-background-color: linear-gradient(to right, #9b59b6, #8e44ad);                                   -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;                                   -fx-background-radius: 15; -fx-padding: 7 20;" text="Email">
                        <graphic>
                            <Label text="✉️" />
                        </graphic>
                        <effect>
                            <DropShadow color="rgba(155,89,182,0.3)" offsetX="0" offsetY="2" radius="5" />
                        </effect>
                    </Button>

                    <Button fx:id="btnAfficherStats" style="-fx-background-color: #edf2f7; -fx-text-fill: #4a5568;                                   -fx-font-size: 14px; -fx-background-radius: 15;                                   -fx-padding: 7 15;" text="Statistiques">
                        <graphic>
                            <Label text="📊" />
                        </graphic>
                    </Button>
                </HBox>

                <!-- Barre de recherche et tri -->
                <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 0 0 10 0;">
                    <!-- Icône de recherche à gauche -->
                    <Label style="-fx-font-size: 18px; -fx-text-fill: #7f8c8d;" text="🔍" />

                    <!-- Champ de texte -->
                    <TextField fx:id="searchField" prefWidth="300" promptText="Rechercher par nom/prénom" style="-fx-background-radius: 15; -fx-border-radius: 15;                       -fx-border-color: #e0e0e0; -fx-padding: 7 15;                       -fx-font-size: 14px;" />

                    <Button fx:id="btnSortDate" onAction="#trierParDate" style="-fx-background-color: #e2e8f0; -fx-text-fill: #4a5568;-fx-font-size: 14px; -fx-background-radius: 15;-fx-padding: 7 15;" text="Trier par date">
                        <graphic>
                            <Label text="📅" />
                        </graphic>
                    </Button>
                </HBox>

                <!-- Tableau -->
                <TableView fx:id="tableNotifications" style="-fx-background-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colNomPrenom" prefWidth="180" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" text="UTILISATEUR" />
                        <TableColumn fx:id="colMessage" prefWidth="300" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" text="MESSAGE" />
                        <TableColumn fx:id="colDate" prefWidth="150" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" text="DATE" />
                        <TableColumn fx:id="colRead" prefWidth="80" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" text="STATUT" />
                        <TableColumn fx:id="colActions" prefWidth="120" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" text="ACTIONS" />
                    </columns>
                </TableView>
            </VBox>
        </StackPane>

        <!-- Pagination -->
        <HBox alignment="CENTER" spacing="10">
            <Label style="-fx-text-fill: #95a5a6; -fx-font-size: 13px;" text="Total: 24 notifications | Non lues: 5" />
        </HBox>
    </VBox>
</AnchorPane>
