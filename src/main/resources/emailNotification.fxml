<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500" prefWidth="600" style="-fx-background-color: #f5f7fa;" xmlns="http://javafx.com/javafx/22.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.EmailNotificationController">

    <VBox alignment="CENTER" layoutX="50" layoutY="30" spacing="20">
        <!-- En-tête -->
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="✉️ Envoyer un Email">
            <effect>
                <DropShadow color="rgba(0,0,0,0.1)" offsetX="1" offsetY="1" radius="3" />
            </effect>
        </Label>

        <!-- Carte du formulaire -->
        <StackPane style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);">
            <VBox prefWidth="500" spacing="15" style="-fx-padding: 25;">
                <!-- Champ Destinataire -->
                <VBox spacing="5">
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" text="DESTINATAIRE" />
                    <TextField fx:id="recipientField" promptText="email@exemple.com" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-padding: 10;" />
                </VBox>

                <!-- Champ Sujet -->
                <VBox spacing="5">
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" text="SUJET" />
                    <TextField fx:id="subjectField" promptText="Sujet du message" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-padding: 10;" />
                </VBox>

                <!-- Champ Message -->
                <VBox spacing="5">
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" text="MESSAGE" />
                    <TextArea fx:id="messageField" prefRowCount="8" promptText="Votre message ici..." style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-padding: 10;" wrapText="true" />
                </VBox>

                <!-- Options -->
                <CheckBox fx:id="htmlCheckbox" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" text="Envoyer au format HTML" />
            </VBox>
        </StackPane>

        <!-- Conteneur pour les boutons -->
        <HBox alignment="CENTER" spacing="20">
            <!-- Bouton Retour -->
            <Button fx:id="btnRetour"  style="-fx-background-color: #e2e8f0; -fx-text-fill: #4a5568;
                      -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 15;
                      -fx-padding: 10 25;" text="Retour">
                <effect>
                    <DropShadow color="rgba(0,0,0,0.1)" offsetX="0" offsetY="2" radius="3" />
                </effect>
            </Button>

            <!-- Bouton d'envoi -->
            <Button fx:id="btnSendEmail" onAction="#envoyerEmail" style="-fx-background-color: linear-gradient(to right, #3498db, #2ecc71);
                      -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;
                      -fx-background-radius: 15; -fx-padding: 10 30;" text="Envoyer l'email">
                <effect>
                    <DropShadow color="rgba(46,204,113,0.3)" offsetX="0" offsetY="2" radius="5" />
                </effect>
            </Button>
        </HBox>

        <!-- Statut -->
        <Label fx:id="statusLabel" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" />
    </VBox>
</AnchorPane>