<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainPane" stylesheets="@styles.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="controllers.DashboardMainController">
    <!-- Sidebar -->
    <left>
        <VBox fx:id="sidebar" prefWidth="200" spacing="10" styleClass="sidebar">
            <children>
                <ImageView fitWidth="120" preserveRatio="true">
                    <image>
                        <Image url="@/logoforblue.png" />
                    </image>
                </ImageView>
                <Button onAction="#openVehiclesAdmin" styleClass="sidebar-button" text="Vehicles" />
                <Button onAction="#openUsersTableAdmin" styleClass="sidebar-button" text="Users" />
                <Button onAction="#openNotificationsAdmin" styleClass="sidebar-button" text="Notifications" />
                <Button onAction="#openPaymentsAdmin" styleClass="sidebar-button" text="Payments" />
                <Button onAction="#openReservationsAdmin" styleClass="sidebar-button" text="Reservations" />
            </children>
            <padding>
                <Insets bottom="10" left="10" right="10" top="20" />
            </padding>
        </VBox>
    </left>
    <center>

    </center>
</BorderPane>
