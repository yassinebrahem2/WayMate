<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.*?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ModifierNotificationController"
            style="-fx-background-color: linear-gradient(to bottom, #f5f7fa 0%, #e4e8eb 100%);">

   <VBox alignment="CENTER" spacing="25" prefWidth="400" layoutX="100" layoutY="40">
      <!-- Titre avec emoji et ombre portée -->
      <Label text="✏️🔔Modifier Notification"
             style="-fx-font-size: 28px; -fx-text-fill: #2c3e50; -fx-font-weight: bold;">
         <effect>
            <DropShadow color="rgba(0,0,0,0.1)" radius="3" offsetX="1" offsetY="1"/>
         </effect>
      </Label>

      <!-- Carte du formulaire avec ombre et arrondis -->
      <StackPane style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);">
         <VBox spacing="20" prefWidth="350">
            <!-- Champ Utilisateur -->
            <VBox spacing="7">
               <Label text="UTILISATEUR" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px; -fx-font-weight: bold;"/>
               <ComboBox fx:id="comboUser"
                         promptText="Sélectionner un utilisateur"
                         style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0;
                                     -fx-padding: 10; -fx-font-size: 14px; -fx-background-insets: 0;"
                         prefWidth="350"/>
            </VBox>

            <!-- Champ Message -->
            <VBox spacing="7">
               <Label text="MESSAGE" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px; -fx-font-weight: bold;"/>
               <TextArea fx:id="textMessage"
                         promptText="Modifier le message ici..."
                         prefRowCount="4"
                         prefWidth="350"
                         style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0;
                                     -fx-padding: 10; -fx-font-size: 14px; -fx-background-insets: 0;"
                         wrapText="true" />
            </VBox>

            <!-- Case à cocher -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 5 0;">
               <CheckBox fx:id="checkConditions" style="-fx-text-fill: #7f8c8d;">
                  <effect>
                     <InnerShadow color="rgba(0,0,0,0.05)" radius="2" choke="0.5"/>
                  </effect>
               </CheckBox>
               <Label text="Je confirme la modification de cette notification"
                      style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;"/>
            </HBox>
         </VBox>
      </StackPane>

      <!-- Bouton avec dégradé et effet hover -->
      <Button fx:id="btnSave"
              text="Sauvegarder"
              style="-fx-background-color: linear-gradient(to right, #3498db, #2ecc71);
                      -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;
                      -fx-background-radius: 25; -fx-padding: 12 40; -fx-cursor: hand;"
              prefWidth="350">
         <effect>
            <DropShadow color="rgba(46,204,113,0.4)" radius="8" offsetX="0" offsetY="4"/>
         </effect>

      </Button>

      <!-- Lien hypertexte -->
      <HBox alignment="CENTER" spacing="5">
         <Label text="Annuler les modifications ?"
                style="-fx-text-fill: #95a5a6; -fx-font-size: 13px;"/>
         <Hyperlink fx:id="hyperlinkAfficher" text="Cliquez ici"
                    style="-fx-text-fill: #3498db; -fx-font-weight: bold; -fx-border-color: transparent; -fx-underline: false;"/>

      </HBox>
   </VBox>
</AnchorPane>