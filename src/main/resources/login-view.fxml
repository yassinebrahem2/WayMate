<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.LoginController">
    <padding>
        <Insets bottom="40" left="30" right="30" top="40" />
    </padding>

    <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="WayMate Login" />

    <TextField fx:id="phoneField" promptText="Phone Number" />
    <PasswordField fx:id="passwordField" promptText="Password" />

    <Button onAction="#handleLogin" prefWidth="150" text="Login" />
    <Button onAction="#goToRegister" prefWidth="150" text="Register" />

    <Label fx:id="errorMessage" textFill="red" visible="false" />
</VBox>