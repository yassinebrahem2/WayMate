<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:id="mainPane" stylesheets="@styles.css" fx:controller="controllers.ClientEditProfileController">
    <!-- Sidebar (same as before) -->
    <left>
        <VBox fx:id="sidebar" spacing="10" prefWidth="200" styleClass="sidebar">
            <children>
                <ImageView fitWidth="120" preserveRatio="true">
                    <image>
                        <Image url="@/logoforblue.png" />
                    </image>
                </ImageView>
                <Button text="Vehicles" styleClass="sidebar-button" />
                <Button text="Users" styleClass="sidebar-button" />
                <Button text="Notifications" styleClass="sidebar-button" />
                <Button text="Payments" styleClass="sidebar-button" />
                <Button text="Reservations" styleClass="sidebar-button" />
            </children>
            <padding>
                <Insets top="20" left="10" right="10" bottom="10" />
            </padding>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <StackPane prefHeight="900.0" prefWidth="1600.0">
            <!-- Edit Profile Card -->
            <VBox styleClass="user-details-container" alignment="CENTER">
                <VBox styleClass="edit-profile-card" alignment="TOP_CENTER" spacing="20">
                    <padding>
                        <Insets top="40" right="40" bottom="40" left="40"/>
                    </padding>

                    <!-- Title -->
                    <Label styleClass="edit-profile-title" text="EDIT PROFILE">
                        <font>
                            <Font name="System Bold" size="24.0" />
                        </font>
                    </Label>

                    <!-- Error Message -->
                    <Label fx:id="messageLabel" styleClass="error-message" text="" visible="false"/>

                    <!-- Editable Fields Grid -->
                    <GridPane hgap="30" vgap="20" alignment="CENTER">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="200" prefWidth="200"/>
                            <ColumnConstraints halignment="LEFT" minWidth="300" prefWidth="300"/>
                        </columnConstraints>

                        <children>
                            <!-- Row 0 -->
                            <Label text="First Name:" styleClass="edit-detail-label" GridPane.rowIndex="0"/>
                            <TextField fx:id="firstNameField" styleClass="edit-detail-field" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <!-- Row 1 -->
                            <Label text="Last Name:" styleClass="edit-detail-label" GridPane.rowIndex="1"/>
                            <TextField fx:id="lastNameField" styleClass="edit-detail-field" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <!-- Row 2 -->
                            <Label text="Username:" styleClass="edit-detail-label" GridPane.rowIndex="2"/>
                            <TextField fx:id="usernameField" styleClass="edit-detail-field" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                            <!-- Row 3 -->
                            <Label text="Email:" styleClass="edit-detail-label" GridPane.rowIndex="3"/>
                            <TextField fx:id="emailField" styleClass="edit-detail-field" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                            <!-- Row 4 -->
                            <Label text="Phone:" styleClass="edit-detail-label" GridPane.rowIndex="4"/>
                            <TextField fx:id="phoneField" styleClass="edit-detail-field" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                            <!-- Row 5 -->
                            <Label text="New Password:" styleClass="edit-detail-label" GridPane.rowIndex="5"/>
                            <PasswordField fx:id="passwordField" styleClass="edit-detail-field" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                            <!-- Row 6 -->
                            <Label text="Confirm Password:" styleClass="edit-detail-label" GridPane.rowIndex="6"/>
                            <PasswordField fx:id="confirmPasswordField" styleClass="edit-detail-field" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                        </children>
                    </GridPane>

                    <!-- Action Buttons -->
                    <HBox alignment="CENTER" spacing="30" styleClass="button-container">
                        <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel"
                                prefHeight="50.0" prefWidth="200.0" styleClass="cancel-button" text="CANCEL" />
                        <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSave"
                                prefHeight="50.0" prefWidth="200.0" styleClass="save-button" text="SAVE CHANGES" />
                    </HBox>
                </VBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>